{
  "name": "muted",
  "version": "3.1.0",
  "description": "Automatically mutes new browser tabs as soon as they are opened",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "copy-webpack-plugin": "^12.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "version:major": "./bump-version.sh major",
    "version:minor": "./bump-version.sh minor",
    "version:patch": "./bump-version.sh patch",
    "release": "npm run version:minor && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danBhentschel/auto-mute.git"
  },
  "author": "Dan Hentschel <dan@hentschels.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/danBhentschel/auto-mute/issues"
  },
  "homepage": "https://github.com/danBhentschel/auto-mute#readme"
}
